# Copy this file and rename it to "config.env"
# Then fill in your actual values
#
# Steps:
#   1. cp config.env.example config.env
#   2. Replace the placeholder values with your real credentials
#   3. NEVER commit config.env to git (it's in .gitignore)

MONGO_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net
JWT_SECRET=your_jwt_secret_here
PORT=5000
CLIENT_URL=http://127.0.0.1:3000
SERVER_URL=http://127.0.0.1:5000
